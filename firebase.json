{
  "hosting": {
    "site": "ihavetools",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "package.json",
      "package-lock.json",
      "PLAN.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
        ]
      },
      {
        "source": "/assets/icons/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ],
    "redirects": [
      { "source": "/tools/base64", "destination": "/tools/base64-encoder/", "type": 301 },
      { "source": "/tools/base64/", "destination": "/tools/base64-encoder/", "type": 301 },
      { "source": "/tools/jpg-to-png", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/jpg-to-png/", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/tool.js", "destination": "/", "type": 301 },
      { "source": "/tools/merge-pdf", "destination": "/tools/pdf-merge/", "type": 301 },
      { "source": "/tools/merge-pdf/", "destination": "/tools/pdf-merge/", "type": 301 },
      { "source": "/tools/split-pdf", "destination": "/tools/pdf-split/", "type": 301 },
      { "source": "/tools/split-pdf/", "destination": "/tools/pdf-split/", "type": 301 },
      { "source": "/tools/rotate-pdf", "destination": "/tools/pdf-rotate/", "type": 301 },
      { "source": "/tools/rotate-pdf/", "destination": "/tools/pdf-rotate/", "type": 301 },
      { "source": "/tools/png-to-jpg", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/png-to-jpg/", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/webp-to-png", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/webp-to-png/", "destination": "/tools/image-converter/", "type": 301 },
      { "source": "/tools/compress-image", "destination": "/tools/image-compressor/", "type": 301 },
      { "source": "/tools/compress-image/", "destination": "/tools/image-compressor/", "type": 301 },
      { "source": "/tools/resize-image", "destination": "/tools/image-resizer/", "type": 301 },
      { "source": "/tools/resize-image/", "destination": "/tools/image-resizer/", "type": 301 },
      { "source": "/tools/json-beautifier", "destination": "/tools/json-formatter/", "type": 301 },
      { "source": "/tools/json-beautifier/", "destination": "/tools/json-formatter/", "type": 301 },
      { "source": "/tools/word-count", "destination": "/tools/word-counter/", "type": 301 },
      { "source": "/tools/word-count/", "destination": "/tools/word-counter/", "type": 301 },
      { "source": "/tools/uuid", "destination": "/tools/uuid-generator/", "type": 301 },
      { "source": "/tools/uuid/", "destination": "/tools/uuid-generator/", "type": 301 },
      { "source": "/tools/bmi", "destination": "/tools/bmi-calculator/", "type": 301 },
      { "source": "/tools/bmi/", "destination": "/tools/bmi-calculator/", "type": 301 },
      { "source": "/tools/emi", "destination": "/tools/emi-calculator/", "type": 301 },
      { "source": "/tools/emi/", "destination": "/tools/emi-calculator/", "type": 301 }
    ]
  }
}
